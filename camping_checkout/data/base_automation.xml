<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Mirrors booking_engine.automation_on_check_in's trigger (rental_status
         entering 'return', i.e. check-in) so guest-room splitting fires from
         every path that checks a booking in: the Pickup button, the guest
         registration wizard, and channel-sync auto-confirmations alike. -->
    <record id="server_action_split_guests_to_pitches" model="ir.actions.server">
        <field name="name">Camping: Split guests to pitches</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="state">code</field>
        <field name="code">record._split_guest_lines_to_pitches()</field>
    </record>
    <!-- One-off backfill: run from any sale order's gear/Action menu (or
         Settings > Technical > Automation > Server Actions > Run) to split
         guests to pitches on orders that were already checked in before this
         feature existed. Ignores which order it was launched from and always
         processes every past check-in, so any order's menu works. -->
    <record id="server_action_backfill_guest_room_split" model="ir.actions.server">
        <field name="name">Camping: Backfill guest room split (past check-ins)</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field
            name="code"
        ><![CDATA[
orders = env["sale.order"].search([("rental_status", "in", ["return", "returned"])])
orders._split_guest_lines_to_pitches()
]]></field>
    </record>
    <record id="automation_on_check_in_split_guests" model="base.automation">
        <field name="name">Camping: Split guests to pitches on check-in</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field
            name="action_server_ids"
            eval="[(6, 0, [ref('server_action_split_guests_to_pitches')])]"
        />
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[('rental_status', 'in', ['return'])]</field>
        <field
            name="filter_pre_domain"
        >[('rental_status', 'not in', ['return'])]</field>
        <field
            name="trigger_field_ids"
            eval="[(6, 0, [ref('sale_renting.field_sale_order__rental_status')])]"
        />
    </record>
</odoo>
