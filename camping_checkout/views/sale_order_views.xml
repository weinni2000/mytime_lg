<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_camping_checkout_animals" model="ir.ui.view">
        <field name="name">sale.order.form.camping.checkout.animals</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pitch" name="camping_checkout_pitch">
                    <group>
                        <field name="pitch_resource_ids" widget="many2many_tags" />
                        <field name="pitch_planning_slot_ids" widget="many2many_tags" />
                    </group>
                </page>
                <page string="Dogs" name="camping_checkout_animals">
                    <field name="animal_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="breed_id" />
                            <field name="product_id" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
