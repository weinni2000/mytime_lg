<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="address_form_fields_birthdate"
        inherit_id="website_sale.address_form_fields"
        name="Checkout birth date"
    >
        <xpath expr="//div[@id='div_phone']" position="after">
            <div id="div_birthdate" class="col-lg-6 mb-2">
                <label class="col-form-label" for="o_birthdate">Date of Birth</label>
                <input
                    id="o_birthdate"
                    type="date"
                    name="birthdate_date"
                    t-att-value="partner_sudo.birthdate_date"
                    class="form-control"
                    required="required"
                />
            </div>
            <div id="div_id_document_front" class="col-lg-6 mb-2">
                <label
                    class="col-form-label label-optional"
                    for="o_id_document_front"
                >Passport / ID Photo</label>
                <input
                    id="o_id_document_front"
                    type="file"
                    name="x_id_document_front"
                    accept="image/*"
                    class="form-control"
                />
            </div>
        </xpath>
    </template>

    <template
        id="address_form_fields_hide_company_vat_street2"
        priority="100"
        inherit_id="website_sale.address_form_fields"
        name="Checkout: hide company/VAT/apartment/state fields"
    >
        <xpath expr="//div[@id='company_name_div']" position="replace" />
        <xpath expr="//div[@id='div_vat']" position="replace" />
        <xpath expr="//div[@id='div_street2']" position="replace" />
        <xpath expr="//div[@id='div_state']" position="replace" />
    </template>

    <template
        id="address_form_fields_priority_countries"
        priority="100"
        inherit_id="website_sale.address_form_fields"
        name="Checkout country shortlist"
    >
        <xpath
            expr="//select[@id='o_country_id']/option[@t-foreach='countries']"
            position="replace"
        >
            <optgroup label="Popular">
                <option
                    t-foreach="priority_countries"
                    t-as="c"
                    t-att-value="c.id"
                    t-att-selected="c.id == (country.id if country else partner_sudo.country_id.id)"
                    t-att-code="c.code"
                    t-out="c.name"
                />
            </optgroup>
            <optgroup label="All countries">
                <option
                    t-foreach="countries"
                    t-as="c"
                    t-att-value="c.id"
                    t-att-selected="c.id == (country.id if country else partner_sudo.country_id.id)"
                    t-att-code="c.code"
                    t-out="c.name"
                />
            </optgroup>
        </xpath>
    </template>
    <template
        id="header_cart_link_camping_step"
        inherit_id="website_sale.header_cart_link"
        name="Header cart icon links to camping step"
    >
        <xpath expr="//a[@href='/shop/cart']" position="attributes">
            <attribute name="href">/shop/camping</attribute>
        </xpath>
    </template>
    <template
        id="cart_selected_pitch"
        inherit_id="website_sale.cart"
        name="Selected camping pitch in order summary"
    >
        <xpath expr="//t[@t-call='website_sale.cart_lines']" position="before">
            <div
                t-if="website_sale_order.pitch_resource_ids"
                class="alert alert-info d-flex align-items-center gap-2 flex-wrap"
            >
                <i class="fa fa-map-marker" />
                <span>Pitches:</span>
                <strong
                    t-out="', '.join(website_sale_order.pitch_resource_ids.mapped('name'))"
                />
            </div>
        </xpath>
    </template>
    <template
        id="cart_summary_pitch_and_qty"
        inherit_id="website_sale.cart_summary_content"
        name="Pitch names and a quantity column in the checkout order summary"
    >
        <xpath expr="//table[hasclass('o_cart_products_table')]" position="before">
            <t
                t-set="camping_pitch_names_by_line"
                t-value="website_sale_order._get_pitch_names_by_line() if website_sale_order else {}"
            />
        </xpath>
        <xpath
            expr="//td[@name='website_sale_cart_summary_product_name']"
            position="inside"
        >
            <div
                t-if="camping_pitch_names_by_line.get(line)"
                class="text-muted small mt-1"
            >
                <i class="fa fa-map-marker me-1" />
                <t t-esc="camping_pitch_names_by_line.get(line)" />
            </div>
        </xpath>
        <xpath
            expr="//td[@name='website_sale_cart_summary_line_price']"
            position="before"
        >
            <td
                class="td-qty pe-2 pt-3 text-end text-muted"
                name="website_sale_cart_summary_qty"
            >
                <t t-out="int(line.product_uom_qty)" />
            </td>
        </xpath>
    </template>
</odoo>
