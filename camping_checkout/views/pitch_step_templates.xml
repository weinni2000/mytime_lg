<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="pitch_step" name="Checkout Pitch Selection">
        <t t-call="website_sale.checkout_layout">
            <t t-set="additional_title">Shop - Pitch</t>
            <t t-set="redirect" t-valuef="/shop/pitch" />
            <t t-set="show_navigation_button" t-value="False" />
            <div id="shop_pitch">
                <h4 class="mb-3">Pitch</h4>
                <p class="text-muted">Select a free pitch for your vehicle and stay.</p>

                <div
                    class="modal fade"
                    id="o_pitch_no_availability_modal"
                    tabindex="-1"
                    role="dialog"
                    aria-labelledby="o_pitch_no_availability_modal_label"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5
                                    class="modal-title"
                                    id="o_pitch_no_availability_modal_label"
                                >No available pitch</h5>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                />
                            </div>
                            <div class="modal-body" t-out="no_availability_message" />
                            <div class="modal-footer">
                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    data-bs-dismiss="modal"
                                >Close</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div
                    t-if="error"
                    class="alert alert-danger"
                    role="alert"
                    t-out="error"
                />
                <!-- Vehicle type / Start / End are shared across the whole order (see
                     _apply_pitch_filters); the visible controls for them now live inside
                     the map component's repeating rows, which submit this form via
                     onFiltersChange instead of rendering their own inputs here. -->
                <form method="get" action="/shop/pitch" id="o_pitch_filters_form">
                    <input
                        id="o_pitch_vehicle_type"
                        type="hidden"
                        name="vehicle_type_id"
                        t-att-value="selected_vehicle_type_id"
                    />
                    <input
                        id="o_pitch_start_date"
                        type="hidden"
                        name="start_date"
                        t-att-value="start_date_value"
                    />
                    <input
                        id="o_pitch_end_date"
                        type="hidden"
                        name="end_date"
                        t-att-value="end_date_value"
                    />
                </form>

                <form
                    action="/shop/pitch/submit"
                    method="post"
                    id="o_pitch_selection_form"
                >
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <input
                        type="hidden"
                        id="pitch_resource_ids"
                        name="pitch_resource_ids"
                        t-att-value="selected_pitch_ids_csv"
                    />

                    <div class="d-flex justify-content-end mb-3">
                        <button
                            type="submit"
                            t-att-disabled="not selected_pitches"
                            class="btn btn-primary pitch_continue_button"
                        >
                            Continue<i class="fw-light fa fa-angle-right ms-2" />
                        </button>
                    </div>

                    <div t-if="campsite_map" class="mb-4">
                        <div
                            class="o_camping_map_booking"
                            t-att-data-zones="zones_json"
                            t-att-data-map-image="map_image_url"
                            t-att-data-legend="map_legend_json"
                            t-att-data-legend-position="map_legend_position"
                            data-selectable="true"
                            t-att-data-selected-items="selected_pitch_ids_csv"
                            t-att-data-products="pitch_products_json"
                            t-att-data-default-product-id="default_pitch_product_id or ''"
                            t-att-data-start-date="start_date_value"
                            t-att-data-end-date="end_date_value"
                            data-input-id="pitch_resource_ids"
                            data-button-selector=".pitch_continue_button"
                            data-filters-form-id="o_pitch_filters_form"
                            data-start-date-input-id="o_pitch_start_date"
                            data-end-date-input-id="o_pitch_end_date"
                            t-att-data-no-availability="'true' if no_availability else 'false'"
                            data-modal-id="o_pitch_no_availability_modal"
                        >
                            <div class="o_camping_map_mount" />
                        </div>
                    </div>
                    <div t-else="" class="alert alert-warning">
                        No active campsite map is configured.
                    </div>

                    <div class="accordion mb-4" id="o_pitch_vehicles_accordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button
                                    t-attf-class="accordion-button {{'' if extra_vehicle_category_ids else 'collapsed'}}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#o_pitch_vehicles_collapse"
                                    t-att-aria-expanded="'true' if extra_vehicle_category_ids else 'false'"
                                    aria-controls="o_pitch_vehicles_collapse"
                                >
                                    <i class="fa fa-car me-2" />Vehicles
                                </button>
                            </h2>
                            <div
                                id="o_pitch_vehicles_collapse"
                                t-attf-class="accordion-collapse collapse {{'show' if extra_vehicle_category_ids else ''}}"
                            >
                                <div class="accordion-body">
                                    <p class="text-muted small mb-3">
                                        1 vehicle is included per Stellplatz. Add any extra
                                        vehicles you're bringing below.
                                    </p>
                                    <div id="extra_vehicle_rows">
                                        <t
                                            t-foreach="extra_vehicle_category_ids"
                                            t-as="category_id"
                                        >
                                            <div
                                                class="extra-vehicle-row row align-items-end mb-2"
                                            >
                                                <div class="col-10">
                                                    <label
                                                        class="col-form-label"
                                                    >Vehicle Category</label>
                                                    <select
                                                        name="x_extra_vehicle_category_id"
                                                        class="form-select"
                                                    >
                                                        <option
                                                            value=""
                                                        >Select...</option>
                                                        <option
                                                            t-foreach="vehicle_types"
                                                            t-as="vehicle_type"
                                                            t-att-value="vehicle_type.id"
                                                            t-att-selected="vehicle_type.id == category_id"
                                                            t-out="vehicle_type.name"
                                                        />
                                                    </select>
                                                </div>
                                                <div class="col-2">
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-danger btn-sm extra-vehicle-row-remove"
                                                        aria-label="Remove vehicle"
                                                    >×</button>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <button
                                        type="button"
                                        id="extra_vehicle_row_add"
                                        class="btn btn-outline-secondary btn-sm mt-1"
                                    >
                                        <i class="fa fa-plus me-1" />Add vehicle
                                    </button>

                                    <template id="extra_vehicle_row_tpl">
                                        <div
                                            class="extra-vehicle-row row align-items-end mb-2"
                                        >
                                            <div class="col-10">
                                                <label
                                                    class="col-form-label"
                                                >Vehicle Category</label>
                                                <select
                                                    name="x_extra_vehicle_category_id"
                                                    class="form-select"
                                                >
                                                    <option value="">Select...</option>
                                                    <option
                                                        t-foreach="vehicle_types"
                                                        t-as="vehicle_type"
                                                        t-att-value="vehicle_type.id"
                                                        t-out="vehicle_type.name"
                                                    />
                                                </select>
                                            </div>
                                            <div class="col-2">
                                                <button
                                                    type="button"
                                                    class="btn btn-outline-danger btn-sm extra-vehicle-row-remove"
                                                    aria-label="Remove vehicle"
                                                >×</button>
                                            </div>
                                        </div>
                                    </template>

                                    <script type="text/javascript">
                                        <![CDATA[
                                        document.addEventListener("DOMContentLoaded", function () {
                                            var rowsContainer = document.getElementById("extra_vehicle_rows");
                                            var rowTpl = document.getElementById("extra_vehicle_row_tpl");
                                            var addBtn = document.getElementById("extra_vehicle_row_add");

                                            addBtn.addEventListener("click", function () {
                                                rowsContainer.appendChild(rowTpl.content.cloneNode(true));
                                            });

                                            rowsContainer.addEventListener("click", function (ev) {
                                                if (ev.target.classList.contains("extra-vehicle-row-remove")) {
                                                    ev.target.closest(".extra-vehicle-row").remove();
                                                }
                                            });
                                        });
                                        ]]>
                                    </script>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div
                        class="d-flex flex-column flex-md-row align-items-center justify-content-between mt32 mb32"
                    >
                        <a
                            role="button"
                            t-att-href="previous_website_checkout_step.step_href or '/shop/camping'"
                            class="btn btn-outline-secondary w-100 w-md-auto order-md-1 order-3"
                        >
                            <i class="fw-light fa fa-angle-left me-2" />Back
                        </a>
                        <button
                            type="submit"
                            t-att-disabled="not selected_pitches"
                            class="btn btn-primary w-100 w-md-auto order-1 order-md-3 pitch_continue_button"
                        >
                            Continue<i class="fw-light fa fa-angle-right ms-2" />
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>
