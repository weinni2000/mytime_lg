<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="pitch_step" name="Checkout Pitch Selection">
        <t t-call="website_sale.checkout_layout">
            <t t-set="additional_title">Shop - Pitch</t>
            <t t-set="redirect" t-valuef="/shop/pitch" />
            <t t-set="show_navigation_button" t-value="False" />
            <div id="shop_pitch">
                <h4 class="mb-3">Pitch</h4>
                <p class="text-muted">Select a free pitch for your vehicle and stay.</p>

                <div
                    t-if="error"
                    class="alert alert-danger"
                    role="alert"
                    t-out="error"
                />
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Vehicle type</label>
                        <div
                            class="form-control bg-light"
                            t-out="vehicle.category_id.name"
                        />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Start</label>
                        <div class="form-control bg-light">
                            <span t-field="order.rental_start_date" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">End</label>
                        <div class="form-control bg-light">
                            <span t-field="order.rental_return_date" />
                        </div>
                    </div>
                </div>

                <form
                    action="/shop/pitch/submit"
                    method="post"
                    id="o_pitch_selection_form"
                >
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <input
                        type="hidden"
                        id="pitch_resource_id"
                        name="pitch_resource_id"
                        t-att-value="selected_pitch.id"
                    />

                    <div t-if="campsite_map" class="mb-4">
                        <div
                            class="o_camping_map_booking"
                            t-att-data-zones="zones_json"
                            t-att-data-map-image="map_image_url"
                            t-att-data-legend="map_legend_json"
                            t-att-data-legend-position="map_legend_position"
                            data-selectable="true"
                            t-att-data-selected-item="selected_pitch.id"
                            data-input-id="pitch_resource_id"
                            data-button-id="pitch_continue_button"
                            data-label-id="selected_pitch_label"
                        >
                            <div class="o_camping_map_mount" />
                        </div>
                        <div class="alert alert-info mt-3 mb-0">
                            Selected pitch:
                            <strong
                                id="selected_pitch_label"
                                t-out="selected_pitch.name or 'None selected'"
                            />
                        </div>
                    </div>
                    <div t-else="" class="alert alert-warning">
                        No active campsite map is configured.
                    </div>

                    <div
                        class="d-flex flex-column flex-md-row align-items-center justify-content-between mt32 mb32"
                    >
                        <a
                            role="button"
                            t-att-href="previous_website_checkout_step.step_href or '/shop/camping'"
                            class="btn btn-outline-secondary w-100 w-md-auto order-md-1 order-3"
                        >
                            <i class="fw-light fa fa-angle-left me-2" />Back
                        </a>
                        <button
                            id="pitch_continue_button"
                            type="submit"
                            t-att-disabled="not selected_pitch"
                            class="btn btn-primary w-100 w-md-auto order-1 order-md-3"
                        >
                            Continue<i class="fw-light fa fa-angle-right ms-2" />
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>
