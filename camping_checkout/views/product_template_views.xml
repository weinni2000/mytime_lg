<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="booking_engine_offers_form_camping" model="ir.ui.view">
        <field name="name">product.template.form.booking.engine.camping</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="booking_engine.booking_engine_offers_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="camping" string="Camping">
                    <group>
                        <field name="x_max_guest" />
                        <field name="x_included_persons" />
                        <field name="x_additional_guest_product_id" />
                        <field name="x_electricity_product_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
