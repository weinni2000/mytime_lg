<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <record id="mail_template_camping_confirmation" model="mail.template">
            <field name="name">Camping: Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order" />
            <field
            name="subject"
        >{{ object._get_camping_confirmation_subject() }}</field>
            <field
            name="email_from"
        >{{ object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field
            name="description"
        >Sent manually from sale orders with product-specific camping information.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <div style="margin: 0px; padding: 0px; font-size: 13px;">
        <t t-out="object._get_camping_confirmation_body_html()" />
    </div>
</div>
            </field>
            <field name="auto_delete" eval="False" />
        </record>
</odoo>
