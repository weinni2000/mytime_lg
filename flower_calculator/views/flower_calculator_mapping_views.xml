<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="flower_calculator_mapping_view_list" model="ir.ui.view">
        <field name="name">flower.calculator.mapping.list</field>
        <field name="model">flower.calculator.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="chatgpt_name" />
                <field name="german_name" />
                <field name="variety" />
                <field name="product_id" />
                <button
                    name="action_ai_find_product"
                    type="object"
                    string="Find Product with AI"
                    class="btn-secondary"
                />
            </list>
        </field>
    </record>

    <record id="flower_calculator_mapping_view_form" model="ir.ui.view">
        <field name="name">flower.calculator.mapping.form</field>
        <field name="model">flower.calculator.mapping</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_ai_find_product"
                        type="object"
                        string="Find Product with AI"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="chatgpt_name" />
                        <field name="german_name" />
                        <field name="variety" />
                        <field name="product_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="flower_calculator_mapping_action" model="ir.actions.act_window">
        <field name="name">Flower Name Mapping</field>
        <field name="res_model">flower.calculator.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="flower_calculator_mapping_menu"
        name="Flower Name Mapping"
        action="flower_calculator_mapping_action"
        parent="sale.menu_sale_config"
    />
</odoo>
