<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_inherit_flower_calculator" model="ir.ui.view">
        <field name="name">res.company.form.inherit.flower.calculator</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="default_flower_small" />
                <field name="default_flower_large" />
            </xpath>
        </field>
    </record>
</odoo>
