<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="flower_calculator_mapping_wizard_view_form" model="ir.ui.view">
        <field name="name">flower.calculator.mapping.wizard.form</field>
        <field name="model">flower.calculator.mapping.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="sale_order_id" invisible="1" />
                <p
                >New flower names detected in this photo that are not mapped to a product yet:</p>
                <field name="new_chatgpt_names" readonly="1" />
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Add to Mapping"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="flower_calculator_mapping_wizard_action" model="ir.actions.act_window">
        <field name="name">Sync Flower Mapping</field>
        <field name="res_model">flower.calculator.mapping.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
