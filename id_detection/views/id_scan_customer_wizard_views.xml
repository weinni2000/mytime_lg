<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="id_scan_customer_wizard_form" model="ir.ui.view">
        <field name="name">id.scan.customer.wizard.form</field>
        <field name="model">id.scan.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="New Customer from Passport">
                <sheet>
                    <field name="order_id" invisible="1" />
                    <p class="text-muted">
                        Upload the front and back image of the customer's passport or
                        ID. A new customer is created and assigned to the rental order.
                    </p>
                    <group>
                        <field
                            name="x_id_document_front"
                            widget="image"
                            options="{'size': [0, 240]}"
                        />
                        <field
                            name="x_id_document_back"
                            widget="image"
                            options="{'size': [0, 240]}"
                        />
                    </group>
                </sheet>
                <footer>
                    <button
                        string="Create Customer &amp; Scan"
                        name="action_create_customer"
                        type="object"
                        class="btn-primary"
                        invisible="not x_id_document_front or not x_id_document_back"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="id_scan_customer_wizard_action" model="ir.actions.act_window">
        <field name="name">New Customer from Passport</field>
        <field name="res_model">id.scan.customer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
