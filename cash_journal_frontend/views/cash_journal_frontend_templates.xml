<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="cash_page" name="Cash Transactions">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="pt40 pb40">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <h1 class="h3 mb-3">Cash Transaction</h1>
                                <t t-if="not journal">
                                    <div class="alert alert-warning" role="alert">
                                        No cash journal is configured on your user.
                                    </div>
                                </t>
                                <t t-if="created">
                                    <div class="alert alert-success" role="alert">
                                        Cash transaction created.
                                    </div>
                                </t>
                                <t t-if="analyzed">
                                    <div class="alert alert-info" role="alert">
                                        Image analyzed. Check the fields before creating the transaction.
                                    </div>
                                </t>
                                <t t-if="error">
                                    <div class="alert alert-danger" role="alert">
                                        <t t-out="error" />
                                    </div>
                                </t>

                                <form
                                    t-if="journal"
                                    action="/cash"
                                    method="post"
                                    enctype="multipart/form-data"
                                    class="mb-4"
                                >
                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"
                                    />
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label
                                                class="form-label"
                                                for="cash_receipt_image"
                                            >Receipt Image</label>
                                            <div class="mb-2" data-cash-camera="1">
                                                <div
                                                    class="d-flex flex-wrap gap-2 align-items-center mb-2"
                                                >
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        data-cash-camera-open="1"
                                                    >
                                                        Use Camera
                                                    </button>
                                                    <img
                                                        class="d-none rounded border"
                                                        style="height: 48px;"
                                                        data-cash-camera-thumbnail="1"
                                                        alt="Captured receipt"
                                                    />
                                                </div>
                                                <input
                                                    id="cash_receipt_image"
                                                    class="form-control"
                                                    type="file"
                                                    name="receipt_image"
                                                    accept="image/*"
                                                    capture="environment"
                                                />
                                                <input
                                                    type="hidden"
                                                    name="captured_receipt_image"
                                                    data-cash-camera-data="1"
                                                />
                                                <t
                                                    t-call="cash_journal_frontend.cash_camera_modal"
                                                />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label
                                                class="form-label"
                                                for="cash_date"
                                            >Date</label>
                                            <input
                                                id="cash_date"
                                                class="form-control"
                                                type="date"
                                                name="date"
                                                t-att-value="form_values.get('date') or today"
                                                required="required"
                                            />
                                        </div>
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-header p-0">
                                                    <button
                                                        type="button"
                                                        class="btn btn-link text-decoration-none w-100 text-start d-flex justify-content-between align-items-center"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#cash_context_collapse"
                                                        aria-expanded="false"
                                                        aria-controls="cash_context_collapse"
                                                    >
                                                        <span>
                                                            <t
                                                                t-out="company.display_name"
                                                            /> · <t
                                                                t-out="journal.display_name"
                                                            />
                                                        </span>
                                                        <i class="fa fa-chevron-down" />
                                                    </button>
                                                </div>
                                                <div
                                                    id="cash_context_collapse"
                                                    class="collapse"
                                                >
                                                    <div class="card-body row g-3">
                                                        <div class="col-md-6">
                                                            <label
                                                                class="form-label"
                                                                for="cash_company"
                                                            >Company</label>
                                                            <select
                                                                id="cash_company"
                                                                class="form-select"
                                                                name="company_id"
                                                            >
                                                                <t
                                                                    t-foreach="companies"
                                                                    t-as="company_option_id"
                                                                >
                                                                    <option
                                                                        t-att-value="company_option_id.id"
                                                                        t-att-selected="str(company_option_id.id) == str(form_values.get('company_id') or default_company_id)"
                                                                    ><t
                                                                            t-out="company_option_id.display_name"
                                                                        /></option>
                                                                </t>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label
                                                                class="form-label"
                                                                for="cash_journal"
                                                            >Journal</label>
                                                            <input
                                                                id="cash_journal"
                                                                class="form-control"
                                                                type="text"
                                                                t-att-value="journal.display_name"
                                                                readonly="readonly"
                                                            />
                                                        </div>
                                                        <div class="col-12">
                                                            <label
                                                                class="form-label"
                                                                for="cash_manual_distribution"
                                                            >Manuelle Verteilung</label>
                                                            <select
                                                                id="cash_manual_distribution"
                                                                class="form-select"
                                                                name="manual_distribution_id"
                                                            >
                                                                <option
                                                                    value=""
                                                                >-</option>
                                                                <t
                                                                    t-foreach="manual_distributions"
                                                                    t-as="manual_distribution_option_id"
                                                                >
                                                                    <option
                                                                        t-att-value="manual_distribution_option_id.id"
                                                                        t-att-selected="str(manual_distribution_option_id.id) == str(form_values.get('manual_distribution_id') or default_manual_distribution_id)"
                                                                    ><t
                                                                            t-out="manual_distribution_option_id.name"
                                                                        /></option>
                                                                </t>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label
                                                class="form-label"
                                                for="cash_analytic_plan"
                                            >Analytic Plan</label>
                                            <select
                                                id="cash_analytic_plan"
                                                class="form-select"
                                                name="analytic_plan_id"
                                            >
                                                <option value="">-</option>
                                                <t
                                                    t-foreach="analytic_plans"
                                                    t-as="analytic_plan_option_id"
                                                >
                                                    <option
                                                        t-att-value="analytic_plan_option_id.id"
                                                        t-att-selected="str(analytic_plan_option_id.id) == str(form_values.get('analytic_plan_id') or default_analytic_plan_id)"
                                                    ><t
                                                            t-out="analytic_plan_option_id.name"
                                                        /></option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label
                                                class="form-label"
                                                for="cash_analytic_account"
                                            >Analytic Account</label>
                                            <div
                                                data-cash-analytic-search="1"
                                                data-cash-analytic-default="1"
                                            >
                                                <div class="d-flex gap-2">
                                                    <select
                                                        id="cash_analytic_account"
                                                        class="form-control"
                                                        name="analytic_account_id"
                                                        data-cash-analytic-select="1"
                                                    >
                                                        <t
                                                            t-if="default_analytic_account_id"
                                                        >
                                                            <option
                                                                t-att-value="default_analytic_account_id"
                                                                selected="selected"
                                                            ><t
                                                                    t-out="default_analytic_account_name"
                                                                /></option>
                                                        </t>
                                                    </select>
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-secondary flex-shrink-0"
                                                        data-cash-analytic-create="1"
                                                        title="Create analytic account"
                                                    >
                                                        <i class="fa fa-plus" />
                                                    </button>
                                                </div>
                                                <input
                                                    type="hidden"
                                                    name="analytic_account_display"
                                                    t-att-value="default_analytic_account_name"
                                                    data-cash-analytic-display="1"
                                                />
                                                <div
                                                    class="small text-muted mt-1 d-none"
                                                    data-cash-analytic-status="1"
                                                />
                                            </div>
                                            <t
                                                t-call="cash_journal_frontend.cash_analytic_account_create_modal"
                                            />
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check form-switch">
                                                <input
                                                    id="cash_kassa_only"
                                                    class="form-check-input"
                                                    type="checkbox"
                                                    name="kassa_only"
                                                    value="1"
                                                    data-cash-kassa-only-toggle="1"
                                                    t-att-checked="bool(form_values.get('kassa_only'))"
                                                />
                                                <label
                                                    class="form-check-label"
                                                    for="cash_kassa_only"
                                                >
                                                    Kassa-Eintrag ohne Gegenbuchung
                                                </label>
                                            </div>
                                        </div>
                                        <div
                                            class="col-12 d-none"
                                            data-cash-kassa-only-fields="1"
                                        >
                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label
                                                        class="form-label"
                                                        for="cash_payment_ref"
                                                    >Label</label>
                                                    <input
                                                        id="cash_payment_ref"
                                                        class="form-control"
                                                        type="text"
                                                        name="payment_ref"
                                                        t-att-value="form_values.get('payment_ref')"
                                                        required="required"
                                                    />
                                                </div>
                                                <div class="col-md-6">
                                                    <label
                                                        class="form-label"
                                                        for="cash_kassa_amount"
                                                    >Amount</label>
                                                    <input
                                                        id="cash_kassa_amount"
                                                        class="form-control"
                                                        type="number"
                                                        step="0.01"
                                                        name="amount"
                                                        t-att-value="form_values.get('amount')"
                                                        required="required"
                                                    />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label
                                                class="form-label"
                                                for="cash_partner"
                                            >Partner</label>
                                            <div data-cash-partner-search="1">
                                                <select
                                                    id="cash_partner"
                                                    class="form-control"
                                                    name="partner_id"
                                                    data-cash-partner-select="1"
                                                >
                                                    <option value="">-</option>
                                                    <t
                                                        t-if="form_values.get('partner_id')"
                                                    >
                                                        <option
                                                            t-att-value="form_values.get('partner_id')"
                                                            selected="selected"
                                                        >
                                                            <t
                                                                t-out="form_values.get('partner')"
                                                            />
                                                        </option>
                                                    </t>
                                                </select>
                                                <input
                                                    type="hidden"
                                                    name="partner"
                                                    t-att-value="form_values.get('partner')"
                                                    data-cash-partner-display="1"
                                                />
                                                <div
                                                    class="small text-muted mt-1 d-none"
                                                    data-cash-partner-status="1"
                                                />
                                            </div>
                                        </div>
                                        <div class="col-12" data-cash-lines="1">
                                            <div
                                                class="d-flex justify-content-between align-items-center mb-2"
                                            >
                                                <h2 class="h6 mb-0">Lines</h2>
                                                <button
                                                    type="button"
                                                    class="btn btn-outline-secondary btn-sm"
                                                    data-cash-line-add="1"
                                                >
                                                    Add Line
                                                </button>
                                            </div>
                                            <div
                                                class="vstack gap-2"
                                                data-cash-line-list="1"
                                            >
                                                <t
                                                    t-foreach="form_lines"
                                                    t-as="cash_line"
                                                    t-key="cash_line_index"
                                                >
                                                    <div
                                                        class="border rounded p-2"
                                                        data-cash-line="1"
                                                    >
                                                        <div
                                                            class="row g-2 align-items-end"
                                                        >
                                                            <div class="col-md-3">
                                                                <label
                                                                    class="form-label"
                                                                >Label</label>
                                                                <input
                                                                    class="form-control"
                                                                    type="text"
                                                                    name="line_label"
                                                                    t-att-value="cash_line.get('label')"
                                                                    required="required"
                                                                />
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label
                                                                    class="form-label"
                                                                >Account</label>
                                                                <select
                                                                    class="form-select"
                                                                    name="line_account_id"
                                                                    required="required"
                                                                >
                                                                    <option
                                                                        value=""
                                                                    >-</option>
                                                                    <t
                                                                        t-foreach="accounts"
                                                                        t-as="account_option_id"
                                                                    >
                                                                        <option
                                                                            t-att-value="account_option_id.id"
                                                                            t-att-selected="str(account_option_id.id) == str(cash_line.get('account_id') or default_account_id)"
                                                                        ><t
                                                                                t-out="account_option_id.code"
                                                                            /> <t
                                                                                t-out="account_option_id.name"
                                                                            /></option>
                                                                    </t>
                                                                </select>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label
                                                                    class="form-label"
                                                                >Analytic Distribution</label>
                                                                <input
                                                                    type="hidden"
                                                                    name="line_analytic_distribution"
                                                                    t-att-value="cash_line.get('analytic_distribution') or '{}'"
                                                                    data-cash-line-distribution="1"
                                                                />
                                                                <input
                                                                    type="hidden"
                                                                    name="line_analytic_distribution_display"
                                                                    t-att-value="cash_line.get('analytic_distribution_display') or default_analytic_account_display"
                                                                    data-cash-line-distribution-display="1"
                                                                />
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-outline-secondary w-100 text-start"
                                                                    data-cash-distribution-open="1"
                                                                >
                                                                    <span
                                                                        data-cash-distribution-summary="1"
                                                                    >
                                                                        <t
                                                                            t-out="cash_line.get('analytic_distribution_display') or default_analytic_account_display"
                                                                        />
                                                                    </span>
                                                                </button>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label
                                                                    class="form-label"
                                                                >Amount <i
                                                                        class="fa fa-info-circle text-muted"
                                                                        title="- ist eine Ausgabe, + ist ein Eingang"
                                                                    /></label>
                                                                <div
                                                                    class="d-flex gap-2"
                                                                >
                                                                    <input
                                                                        class="form-control"
                                                                        type="number"
                                                                        name="line_amount"
                                                                        step="0.01"
                                                                        t-att-value="cash_line.get('amount')"
                                                                        required="required"
                                                                    />
                                                                    <button
                                                                        type="button"
                                                                        class="btn btn-outline-secondary"
                                                                        data-cash-line-remove="1"
                                                                        title="Remove line"
                                                                    >
                                                                        <i
                                                                            class="fa fa-trash"
                                                                        />
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                            <template data-cash-line-template="1">
                                                <div
                                                    class="border rounded p-2"
                                                    data-cash-line="1"
                                                >
                                                    <div
                                                        class="row g-2 align-items-end"
                                                    >
                                                        <div class="col-md-3">
                                                            <label
                                                                class="form-label"
                                                            >Label</label>
                                                            <input
                                                                class="form-control"
                                                                type="text"
                                                                name="line_label"
                                                                required="required"
                                                            />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label
                                                                class="form-label"
                                                            >Account</label>
                                                            <select
                                                                class="form-select"
                                                                name="line_account_id"
                                                                required="required"
                                                            >
                                                                <option
                                                                    value=""
                                                                >-</option>
                                                                <t
                                                                    t-foreach="accounts"
                                                                    t-as="account_template_option_id"
                                                                >
                                                                    <option
                                                                        t-att-value="account_template_option_id.id"
                                                                        t-att-selected="account_template_option_id.id == default_account_id"
                                                                    ><t
                                                                            t-out="account_template_option_id.code"
                                                                        /> <t
                                                                            t-out="account_template_option_id.name"
                                                                        /></option>
                                                                </t>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label
                                                                class="form-label"
                                                            >Analytic Distribution</label>
                                                            <input
                                                                type="hidden"
                                                                name="line_analytic_distribution"
                                                                t-att-value="default_analytic_distribution"
                                                                data-cash-line-distribution="1"
                                                            />
                                                            <input
                                                                type="hidden"
                                                                name="line_analytic_distribution_display"
                                                                t-att-value="default_analytic_account_display"
                                                                data-cash-line-distribution-display="1"
                                                            />
                                                            <button
                                                                type="button"
                                                                class="btn btn-outline-secondary w-100 text-start"
                                                                data-cash-distribution-open="1"
                                                            >
                                                                <span
                                                                    data-cash-distribution-summary="1"
                                                                >
                                                                    <t
                                                                        t-out="default_analytic_account_display"
                                                                    />
                                                                </span>
                                                            </button>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label
                                                                class="form-label"
                                                            >Amount <i
                                                                    class="fa fa-info-circle text-muted"
                                                                    title="- ist eine Ausgabe, + ist ein Eingang"
                                                                /></label>
                                                            <div class="d-flex gap-2">
                                                                <input
                                                                    class="form-control"
                                                                    type="number"
                                                                    name="line_amount"
                                                                    step="0.01"
                                                                    required="required"
                                                                />
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-outline-secondary"
                                                                    data-cash-line-remove="1"
                                                                    title="Remove line"
                                                                >
                                                                    <i
                                                                        class="fa fa-trash"
                                                                    />
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </template>
                                            <t
                                                t-call="cash_journal_frontend.cash_distribution_modal"
                                            />
                                        </div>
                                        <div class="col-12 text-end">
                                            <button
                                                type="submit"
                                                name="action"
                                                value="analyze"
                                                class="btn btn-outline-secondary me-2"
                                                formnovalidate="formnovalidate"
                                            >
                                                Analyze Image
                                            </button>
                                            <button
                                                type="submit"
                                                name="action"
                                                value="create"
                                                class="btn btn-primary"
                                            >
                                                Create
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <t t-if="recent_lines">
                                    <h2 class="h5 mb-3">Recent Transactions</h2>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Label</th>
                                                    <th>Partner</th>
                                                    <th class="text-end">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr
                                                    t-foreach="recent_lines"
                                                    t-as="line_id"
                                                >
                                                    <td><t t-out="line_id.date" /></td>
                                                    <td><t
                                                            t-out="line_id.payment_ref"
                                                        /></td>
                                                    <td><t
                                                            t-out="line_id.partner_id.display_name"
                                                        /></td>
                                                    <td class="text-end"><t
                                                            t-out="line_id.amount"
                                                        /></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
