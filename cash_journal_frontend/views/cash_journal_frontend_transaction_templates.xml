<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="cash_page_transactions"
        inherit_id="cash_journal_frontend.cash_page"
        name="Cash Transaction Flow"
    >
        <xpath expr="//form[@action='/cash']" position="after">
            <t t-if="cash_flow_lines">
                <div class="card mb-4">
                    <div class="card-header p-0">
                        <button
                            type="button"
                            class="btn btn-link text-decoration-none w-100 text-start d-flex justify-content-between align-items-center"
                            data-bs-toggle="collapse"
                            data-bs-target="#cash_flow_collapse"
                            aria-expanded="false"
                            aria-controls="cash_flow_collapse"
                        >
                            <span>Ein- und Ausgänge</span>
                            <i class="fa fa-chevron-down" />
                        </button>
                    </div>
                    <div id="cash_flow_collapse" class="collapse">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Label</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr
                                        t-foreach="cash_flow_lines"
                                        t-as="line_id"
                                        t-att-class="'table-success' if line_id.amount &gt;= 0 else 'table-danger'"
                                    >
                                        <td><t t-out="line_id.date" /></td>
                                        <td><t t-out="line_id.payment_ref" /></td>
                                        <td class="text-end">
                                            <t t-out="line_id.amount" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
