<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ressource_map.ResourceMap">
        <div class="o_camping_map_overlay">
            <img
                t-att-src="props.mapImageUrl"
                class="o_camping_map_img img-fluid"
                t-ref="mapImage"
                t-att-style="state.availableHeight ? 'max-height: ' + state.availableHeight + 'px' : undefined"
                t-on-load="onImageLoad"
                alt="Camping map"
            />
            <svg
                t-if="state.naturalWidth"
                class="o_camping_map_svg"
                t-attf-viewBox="0 0 {{state.naturalWidth}} {{state.naturalHeight}}"
                preserveAspectRatio="xMidYMid meet"
                t-on-click="onMapClick"
            >
                <t
                    t-if="!isDrafting"
                    t-foreach="props.zones"
                    t-as="zone"
                    t-key="zone.id"
                >
                    <polygon
                        t-att-points="zonePointsString(zone)"
                        t-att-class="zoneClass(zone)"
                        t-att-style="zoneStyle(zone)"
                        t-on-mouseenter="() => this.onZoneHover(zone.id)"
                        t-on-mouseleave="() => this.onZoneHover(null)"
                        t-on-click="(ev) => this.onZoneClick(zone, ev)"
                    />
                    <!-- Proportional occupancy slices, drawn on top of the
                         (transparent) zone so clicks still hit the zone. -->
                    <polygon
                        t-foreach="zonePolygonParts(zone)"
                        t-as="part"
                        t-key="'part-' + zone.id + '-' + part_index"
                        t-attf-class="o_camping_map_zone_part {{part.colorClass or ''}}"
                        t-att-points="part.points"
                        t-att-style="part.color ? ('fill: ' + part.color) : undefined"
                    />
                    <g
                        t-if="props.editable and props.onRemoveZone"
                        class="o_camping_map_zone_remove"
                        t-att-transform="'translate(' + zoneTopRight(zone).x + ',' + zoneTopRight(zone).y + ')'"
                        t-on-click.stop="() => this.onRemoveZoneClick(zone)"
                    >
                        <title>Remove polygon</title>
                        <circle r="12" />
                        <line x1="-5" y1="-5" x2="5" y2="5" />
                        <line x1="-5" y1="5" x2="5" y2="-5" />
                    </g>
                    <foreignObject
                        t-if="zone.code"
                        t-att-x="zoneMarkerBox(zone).x"
                        t-att-y="zoneMarkerBox(zone).y"
                        t-att-width="zoneMarkerBox(zone).width"
                        t-att-height="zoneMarkerBox(zone).height"
                        class="o_camping_map_zone_marker"
                    >
                        <div
                            xmlns="http://www.w3.org/1999/xhtml"
                            class="o_camping_map_zone_marker_badge"
                            t-attf-style="--o-label-font: {{labelFontPx}}px"
                        >
                            <i t-if="zone.symbol" t-attf-class="fa {{zone.symbol}}" />
                            <span t-esc="zone.code" />
                        </div>
                    </foreignObject>
                    <!--
                    <foreignObject
                        t-att-x="zoneLabelPosition(zone).x - 90"
                        t-att-y="zoneLabelPosition(zone).y - 15"
                        width="180"
                        height="30"
                        class="o_camping_map_zone_label"
                    >
                        <div
                            xmlns="http://www.w3.org/1999/xhtml"
                            class="badge rounded-pill text-bg-dark"
                            t-esc="zone.name"
                        />
                    </foreignObject>
                    -->
                </t>
                <t t-if="props.editable and state.editZoneId">
                    <line
                        t-foreach="state.editPoints"
                        t-as="corner"
                        t-key="'edge-' + corner_index"
                        class="o_camping_map_edge"
                        t-att-x1="corner[0]"
                        t-att-y1="corner[1]"
                        t-att-x2="state.editPoints[(corner_index + 1) % state.editPoints.length][0]"
                        t-att-y2="state.editPoints[(corner_index + 1) % state.editPoints.length][1]"
                        t-on-click="(ev) => this.insertCorner(corner_index, ev)"
                    />
                    <circle
                        t-foreach="state.editPoints"
                        t-as="corner"
                        t-key="corner_index"
                        class="o_camping_map_corner"
                        t-att-cx="corner[0]"
                        t-att-cy="corner[1]"
                        r="9"
                        t-on-pointerdown="(ev) => this.onCornerPointerDown(corner_index, ev)"
                        t-on-pointermove="(ev) => this.onCornerPointerMove(corner_index, ev)"
                        t-on-pointerup="(ev) => this.onCornerPointerUp(corner_index, ev)"
                        t-on-dblclick="(ev) => this.removeCorner(corner_index, ev)"
                    />
                </t>
                <polyline
                    t-if="props.draftPoints"
                    t-att-points="props.draftPoints"
                    class="o_camping_map_zone_draft"
                />
                <g
                    t-if="props.draftPoints and props.onCloseDraft and draftStartPoint"
                    class="o_camping_map_draft_close"
                    t-on-click.stop="onCloseDraftClick"
                >
                    <title>Close and save the zone</title>
                    <circle
                        t-att-cx="draftStartPoint[0]"
                        t-att-cy="draftStartPoint[1]"
                        r="8"
                    />
                    <circle
                        t-att-cx="draftStartPoint[0]"
                        t-att-cy="draftStartPoint[1]"
                        r="3"
                        class="o_camping_map_draft_close_dot"
                    />
                </g>
            </svg>
            <div t-if="showLegend" t-att-class="legendClass" t-att-style="legendStyle">
                <div
                    t-foreach="props.legend"
                    t-as="entry"
                    t-key="entry_index"
                    class="o_camping_map_legend_item"
                >
                    <span
                        t-attf-class="o_camping_map_legend_swatch {{entry.color_class or ''}}"
                        t-att-style="entry.color ? ('background-color: ' + entry.color) : undefined"
                    />
                    <span t-esc="entry.label" />
                </div>
            </div>
            <div
                t-if="hoveredZone"
                class="o_camping_map_tooltip"
                t-esc="hoveredZone.name"
            />
            <div t-if="selectedZone" class="o_camping_map_panel">
                <div class="o_camping_map_panel_header">
                    <h4 t-esc="selectedZone.name" />
                    <button
                        type="button"
                        class="btn-close"
                        aria-label="Close"
                        t-on-click="closePanel"
                    />
                </div>
                <div class="o_camping_map_panel_body">
                    <t t-if="selectedZone.products.length">
                        <t
                            t-foreach="selectedZone.products"
                            t-as="product"
                            t-key="product.id"
                        >
                            <a
                                t-if="product.url"
                                t-att-href="product.url"
                                class="o_camping_map_pitch"
                            >
                                <span t-esc="product.name" />
                                <span
                                    class="o_camping_map_pitch_price"
                                    t-esc="product.price"
                                />
                            </a>
                            <button
                                t-if="!product.url and props.onSelectItem"
                                type="button"
                                t-att-class="itemClass(product)"
                                t-att-disabled="!product.selectable"
                                t-on-click="() => this.onItemClick(product)"
                            >
                                <span t-esc="product.name" />
                                <small
                                    t-if="product.state"
                                    class="d-block opacity-75"
                                    t-esc="itemStateLabel(product)"
                                />
                            </button>
                            <div t-elif="!product.url" class="o_camping_map_pitch">
                                <span t-esc="product.name" />
                            </div>
                        </t>
                    </t>
                    <p t-else="" class="text-muted mb-0">
                        No pitches available in this area yet.
                    </p>
                </div>
            </div>
        </div>
    </t>
</templates>
