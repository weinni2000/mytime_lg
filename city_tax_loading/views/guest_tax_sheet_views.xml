<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="guest_tax_sheet_list_view" model="ir.ui.view">
        <field name="name">guest.tax.sheet.list</field>
        <field name="model">guest.tax.sheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="x_sheet_url" />
                <field name="x_month" />
            </list>
        </field>
    </record>

    <record id="guest_tax_sheet_form_view" model="ir.ui.view">
        <field name="name">guest.tax.sheet.form</field>
        <field name="model">guest.tax.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="Load Month From URL"
                        type="object"
                        name="action_load_month"
                        class="btn-primary"
                        invisible="not x_sheet_url"
                    />
                    <button
                        string="Load Month From File"
                        type="object"
                        name="action_load_month_from_file"
                        class="btn-primary"
                        invisible="not x_file"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="x_sheet_url" />
                        <field name="x_file" filename="x_filename" />
                        <field name="x_filename" invisible="1" />
                        <field name="x_month" />
                    </group>
                    <notebook>
                        <page string="Guest Tax Messages" name="guest_tax_messages">
                            <field name="x_guest_tax_message_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="x_sale_order_id" />
                                    <field
                                        name="x_guest_line_ids"
                                        widget="many2many_tags"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="technical">
                            <field name="x_guest_tax_message_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="x_deskline_master_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="guest_tax_sheet_action" model="ir.actions.act_window">
        <field name="name">Guest Tax Sheets</field>
        <field name="res_model">guest.tax.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_guest_tax_sheet"
        name="Guest Tax Sheets"
        parent="booking_engine.menu_availability_steering"
        action="guest_tax_sheet_action"
        sequence="33"
    />
</odoo>
