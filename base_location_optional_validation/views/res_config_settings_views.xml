<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.base.location.optional.validation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                <setting
                    id="validate_locations_setting"
                    string="Validate Locations"
                    help="Require the country, state, city and zip on partners and companies to match their selected ZIP Location"
                >
                    <field name="validate_locations" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
