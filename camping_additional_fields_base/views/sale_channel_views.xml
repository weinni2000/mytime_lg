<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_channel_view_form_ota" model="ir.ui.view">
        <field name="name">sale.channel.form.ota</field>
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_channel.sale_channel_view_form" />
        <field name="arch" type="xml">
            <field name="channel_type" position="after">
                <field name="ota" />
                <field name="ota_payment" invisible="not ota" />
            </field>
        </field>
    </record>

    <record id="sale_channel_view_tree_ota" model="ir.ui.view">
        <field name="name">sale.channel.list.ota</field>
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_channel.sale_channel_view_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ota" />
                <field name="ota_payment" optional="show" />
            </field>
        </field>
    </record>
</odoo>
