<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="planning_role_action" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">planning.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="planning_role_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="planning.planning_role_view_tree" />
        <field name="act_window_id" ref="planning_role_action" />
    </record>

    <record id="planning_role_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="planning.planning_role_view_form" />
        <field name="act_window_id" ref="planning_role_action" />
    </record>

    <menuitem
        id="planning_role_menu"
        name="Roles"
        parent="booking_engine.booking_engine_rooms_menu"
        action="planning_role_action"
        sequence="50"
    />
</odoo>
