<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_directions" model="ir.ui.view">
        <field name="name">product.template.form.directions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <group name="group_general" position="inside">
                <group>
                <field name="directions" />
                </group>
            </group>
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="directions" string="Directions">
                <group name="group_directions" colspan="4" label="Directions">
                <group>
                    <field name="directions" />
                    </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_room_offer_position" model="ir.ui.view">
        <field name="name">product.template.product.form.room.offer.position</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="booking_engine.booking_engine_offers_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='group_general_info']//field[@name='x_has_city_tax']"
                position="after"
            >
                <field name="x_is_a_room_offer" />
            </xpath>
        </field>
    </record>
</odoo>
