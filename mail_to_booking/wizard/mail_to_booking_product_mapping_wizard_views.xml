<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mail_to_booking_product_mapping_wizard_form" model="ir.ui.view">
        <field name="name">mail.to.booking.product.mapping.wizard.form</field>
        <field name="model">mail.to.booking.product.mapping.wizard</field>
        <field name="arch" type="xml">
            <form string="Choose Product">
                <group>
                    <field name="sale_channel_id" />
                    <field name="product_hint" />
                    <field name="product_id" />
                    <field name="force_single_product" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Map and Reprocess"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
