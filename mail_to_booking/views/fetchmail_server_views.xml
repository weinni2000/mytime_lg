<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_email_server_form_mail_to_booking" model="ir.ui.view">
        <field name="name">fetchmail.server.form.mail.to.booking</field>
        <field name="model">fetchmail.server</field>
        <field name="inherit_id" ref="mail.view_email_server_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='object_id']" position="after">
                <field name="company_id" groups="base.group_multi_company" />
                <field name="mail_to_booking_enabled" />
                <field name="notify_user_id" invisible="not mail_to_booking_enabled" />
            </xpath>
            <xpath expr="//field[@name='object_id']" position="attributes">
                <attribute name="readonly">mail_to_booking_enabled</attribute>
            </xpath>
            <xpath expr="//page[@name='advanced_options']" position="after">
                <page name="mail_to_booking_allowed_products" string="Allowed Products">
                    <field name="allowed_product_ids">
                        <list create="0">
                            <field name="name" />
                        </list>
                    </field>
                </page>
                <page name="mail_to_booking_sales_channels" string="Sales Channels">
                    <field name="available_sale_channel_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="name" />
                            <field name="email" />
                            <field name="force_single_product" />
                            <field
                                name="default_product_id"
                                invisible="not force_single_product"
                            />
                        </list>
                    </field>
                </page>
                <page name="mail_to_booking_mails" string="Mails">
                    <field name="message_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="date" />
                            <field name="email_from" />
                            <field name="subject" />
                            <field name="state" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
