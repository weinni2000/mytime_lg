<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_mail_to_booking" model="ir.ui.view">
        <field name="name">res.company.form.mail.to.booking</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page
                    name="mail_to_booking"
                    string="Mail to Booking"
                    groups="base.group_system"
                >
                    <group string="DeepSeek">
                        <field name="deepseek_api_key" password="True" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
