<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_to_booking_excluded_email_list_view" model="ir.ui.view">
        <field name="name">mail.to.booking.excluded.email.list</field>
        <field name="model">mail.to.booking.excluded.email</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="email" />
                <field name="note" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="mail_to_booking_excluded_email_action" model="ir.actions.act_window">
        <field name="name">Excluded Emails</field>
        <field name="res_model">mail.to.booking.excluded.email</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="mail_to_booking_excluded_email_menu"
        name="Excluded Emails"
        parent="mail_to_booking_parent_menu"
        action="mail_to_booking_excluded_email_action"
        sequence="35"
    />
</odoo>
