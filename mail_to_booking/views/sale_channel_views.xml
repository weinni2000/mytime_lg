        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_channel.sale_channel_view_form" />
        <field name="arch" type="xml">
            <group name="general_info" position="inside">
                <field name="email" />
                <field name="synonyms" placeholder="Alpaca Camping&#10;Another name" />
                <field name="force_single_product" />
