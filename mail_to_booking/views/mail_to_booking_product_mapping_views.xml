<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_to_booking_product_mapping_list_view" model="ir.ui.view">
        <field name="name">mail.to.booking.product.mapping.list</field>
        <field name="model">mail.to.booking.product.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sale_channel_id" />
                <field name="product_hint" />
                <field name="product_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="mail_to_booking_product_mapping_action" model="ir.actions.act_window">
        <field name="name">Product Mapping</field>
        <field name="res_model">mail.to.booking.product.mapping</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="mail_to_booking_product_mapping_menu"
        name="Product Mapping"
        parent="mail_to_booking_parent_menu"
        action="mail_to_booking_product_mapping_action"
        sequence="20"
    />
</odoo>
