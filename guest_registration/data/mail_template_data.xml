<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="mail_template_guest_registration" model="mail.template">
        <field name="name">Guest Registration: Link</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field
            name="subject"
        >{{ object.company_id.name }}: complete your booking details</field>
        <field
            name="email_from"
        >{{ object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field
            name="description"
        >Sent manually from bookings to ask the customer to complete address, contact and guest information.</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.partner_id.name" />,</p>
    <p>
        Please complete your booking <t t-out="object.name" /> by filling in your
        address, contact information and the names of your fellow guests using the
        link below:
    </p>
    <p>
        <a
                        t-att-href="object._get_guest_registration_url()"
                        t-out="object._get_guest_registration_url()"
                    />
    </p>
    <p>Thank you!</p>
</div>
        </field>
        <field name="auto_delete" eval="False" />
    </record>
</odoo>
