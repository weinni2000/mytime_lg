<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="guest_registration_wizard_view_form" model="ir.ui.view">
        <field name="name">guest.registration.wizard.form</field>
        <field name="model">guest.registration.wizard</field>
        <field name="arch" type="xml">
            <form string="Guest Registration">
                <field name="sale_order_id" invisible="1" />
                <div
                    class="alert alert-info d-flex align-items-center gap-2 mb-3"
                    role="alert"
                >
                    <span>Prefer the guest to fill this in themselves?</span>
                    <field
                        name="url"
                        widget="CopyClipboardURL"
                        readonly="1"
                        nolabel="1"
                        class="flex-grow-1"
                    />
                    <button
                        string="Open Web Form"
                        type="object"
                        name="action_open_web_form"
                        class="btn-link p-0"
                    />
                </div>

                <group string="Scan ID / Passport">
                    <field
                        name="id_document_front"
                        widget="image"
                        options="{'size': [200, 200]}"
                    />
                    <field
                        name="id_document_back"
                        widget="image"
                        options="{'size': [200, 200]}"
                    />
                </group>
                <button
                    string="Scan Document"
                    type="object"
                    name="action_scan_id_documents"
                    class="btn-secondary mb-3"
                />

                <group string="Booking Details">
                    <group>
                        <field name="rental_start_date" />
                        <field name="rental_return_date" />
                        <field name="product_id" />
                    </group>
                    <group>
                        <field name="immediate_payment" />
                        <field name="journal_id" invisible="not immediate_payment" />
                    </group>
                </group>

                <group string="Address &amp; Contact">
                    <group>
                        <field name="name" />
                        <field name="birthdate_date" />
                        <field
                            name="location_id"
                            placeholder="e.g. 6020 or Innsbruck"
                        />
                        <field name="street" />
                        <field name="zip" />
                        <field name="city" />
                        <field name="country_id" />
                    </group>
                    <group>
                        <field name="email" />
                        <field name="phone" />
                    </group>
                </group>

                <group string="Other Guests">
                    <button
                        string="Add Guest"
                        type="object"
                        name="action_open_guest_wizard"
                        class="btn-secondary mb-2"
                    />
                    <field name="guest_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="guest_line_id" column_invisible="True" />
                            <field name="guest_partner_id" column_invisible="True" />
                            <field name="name" />
                            <field name="is_child" />
                        </list>
                    </field>
                </group>

                <footer>
                    <button
                        string="Confirm"
                        type="object"
                        name="action_confirm"
                        class="btn-primary"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
