<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="guest_registration_guest_wizard_view_form" model="ir.ui.view">
        <field name="name">guest.registration.guest.wizard.form</field>
        <field name="model">guest.registration.guest.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Guest">
                <field name="wizard_id" invisible="1" />
                <field name="guest_partner_id" invisible="1" />

                <group string="Scan ID / Passport">
                    <field
                        name="id_document_front"
                        widget="image"
                        options="{'size': [200, 200]}"
                    />
                    <field
                        name="id_document_back"
                        widget="image"
                        options="{'size': [200, 200]}"
                    />
                </group>
                <button
                    string="Scan Document"
                    type="object"
                    name="action_scan_id_documents"
                    class="btn-secondary mb-3"
                />

                <group>
                    <field name="name" />
                    <field name="is_child" />
                    <field name="birthdate_date" />
                </group>
                <group string="Address">
                    <field name="street" />
                    <field name="zip" />
                    <field name="city" />
                    <field name="country_id" />
                    <field name="nationality_id" />
                </group>

                <footer>
                    <button
                        string="Add Guest"
                        type="object"
                        name="action_add_guest"
                        class="btn-primary"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
