<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.no.dropped.mail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='discuss']" position="after">
                <block title="No Dropped Mail" id="no_dropped_mail_setting">
                    <setting
                        id="no_dropped_mail_enabled_setting"
                        string="Catch Dropped Mails"
                        help="Post incoming e-mails that match no alias into a Discuss channel instead of dropping them."
                    >
                        <field name="no_dropped_mail_enabled" />
                        <div
                            class="content-group mt16"
                            invisible="not no_dropped_mail_enabled"
                        >
                            <div class="row">
                                <label
                                    for="no_dropped_mail_channel_id"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="no_dropped_mail_channel_id" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
