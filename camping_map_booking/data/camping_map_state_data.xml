<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="camping_map_state_free" model="camping.map.state">
        <field name="name">Free</field>
        <field name="code">free</field>
        <field name="color">#198754</field>
        <field name="stroke_color">#146c43</field>
        <field name="hover_color">#22a06b</field>
        <field name="sequence">10</field>
    </record>
    <record id="camping_map_state_occupied" model="camping.map.state">
        <field name="name">Occupied</field>
        <field name="code">occupied</field>
        <!-- Salmon-pink matching the Planning gantt's booked-pill color
             (mix of Odoo red #ee2d2d with white, 60%). -->
        <field name="color">#F58181</field>
        <field name="stroke_color">#E06666</field>
        <field name="hover_color">#F26D6D</field>
        <field name="sequence">20</field>
    </record>
    <record id="camping_map_state_not_suitable" model="camping.map.state">
        <field name="name">Not suitable</field>
        <field name="code">not_suitable</field>
        <field name="color">#dc3545</field>
        <field name="stroke_color">#b02a37</field>
        <field name="hover_color">#e35d6a</field>
        <field name="sequence">30</field>
    </record>
</odoo>
