<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="camping_map_booking.CampingZoneMapField">
        <div class="o_camping_map_booking o_camping_map_backend_preview">
            <ResourceMap
                t-if="mapImageUrl"
                zones="shapes"
                mapImageUrl="mapImageUrl"
                legend="legend"
                legendPosition="legendPosition"
            />
            <p t-else="" class="text-muted mb-0">
                Set this zone's map and draw its outline to preview it here.
            </p>
        </div>
    </t>
</templates>
