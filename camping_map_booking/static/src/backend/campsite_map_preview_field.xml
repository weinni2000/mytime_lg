<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="camping_map_booking.CampsiteMapPreviewField">
        <div
            class="o_camping_map_booking o_camping_map_backend_preview o_camping_map_editor"
        >
            <div class="d-flex align-items-end gap-2 mb-3">
                <button
                    type="button"
                    class="btn btn-success"
                    t-on-click="startNewPolygon"
                    t-att-disabled="!state.selectedZoneId"
                >
                    <i class="fa fa-plus me-1" />New polygon<t
                        t-if="selectedZoneName"
                    >: <t t-esc="selectedZoneName" /></t>
                </button>
                <div class="flex-grow-1">
                    <label class="form-label">Zone</label>
                    <select class="form-select" t-on-change="onZoneChange">
                        <option value="">Select a zone...</option>
                        <option
                            t-foreach="state.zones"
                            t-as="zone"
                            t-key="zone.id"
                            t-att-value="zone.id"
                            t-esc="zone.name"
                        />
                    </select>
                </div>
                <button
                    type="button"
                    class="btn btn-secondary"
                    t-on-click="undoPoint"
                    t-att-disabled="!state.draftPoints.length"
                >Undo</button>
                <button
                    type="button"
                    class="btn btn-secondary"
                    t-on-click="clearPoints"
                    t-att-disabled="!state.draftPoints.length"
                >Clear</button>
                <button
                    type="button"
                    class="btn btn-primary"
                    t-on-click="saveZone"
                >Save Zone</button>
                <div class="d-flex flex-column">
                    <label class="form-label">Label size</label>
                    <input
                        type="range"
                        class="form-range"
                        min="0.5"
                        max="3"
                        step="0.1"
                        style="width: 130px;"
                        t-att-value="labelScale"
                        t-on-input="onLabelScaleChange"
                    />
                </div>
            </div>
            <p class="text-muted" t-if="state.drawing">
                Click around the boundary of the zone. The zone closes automatically when saved.
            </p>
            <ResourceMap
                t-if="mapImageUrl"
                zones="zones"
                mapImageUrl="mapImageUrl"
                editable="true"
                draftPoints="draftPoints"
                legend="legend"
                legendPosition="legendPosition"
                labelScale="labelScale"
                onMapClick.bind="addPoint"
                onRemoveZone.bind="removeZone"
                onCloseDraft.bind="saveZone"
                onCornersChanged.bind="onCornersChanged"
            />
        </div>
    </t>
</templates>
