<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="camping_vehicle_type_view_list" model="ir.ui.view">
        <field name="name">camping.vehicle.type.list</field>
        <field name="model">camping.vehicle.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="camping_vehicle_type_action" model="ir.actions.act_window">
        <field name="name">Vehicle Types</field>
        <field name="res_model">camping.vehicle.type</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="camping_vehicle_type_menu"
        name="Vehicle Types"
        action="camping_vehicle_type_action"
        parent="camping_maps_menu"
        sequence="15"
    />
</odoo>
