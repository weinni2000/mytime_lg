<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="camping_map_zone_view_list" model="ir.ui.view">
        <field name="name">camping.map.zone.list</field>
        <field name="model">camping.map.zone</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        name="action_view_map"
                        type="object"
                        string="View on Map"
                        class="btn-primary"
                    />
                </header>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="symbol" />
                <field name="map_id" />
                <field name="hide_on_frontend_map" optional="show" />
                <field name="resource_ids" widget="many2many_tags" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="camping_map_zone_view_form" model="ir.ui.view">
        <field name="name">camping.map.zone.form</field>
        <field name="model">camping.map.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="symbol" />
                        <field name="map_id" />
                        <field name="hide_on_frontend_map" />
                        <field name="sequence" />
                        <field name="active" invisible="1" />
                        <field name="points" />
                    </group>
                    <notebook>
                        <page name="pitches" string="Resources">
                            <group>
                                <field
                                    name="resource_ids"
                                    string="Resources"
                                    widget="many2many_tags"
                                    context="{'active_test': False}"
                                    options="{'no_create': True}"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="camping_map_zone_action" model="ir.actions.act_window">
        <field name="name">Camping Map Zones</field>
        <field name="res_model">camping.map.zone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="camping_maps_menu"
        name="Maps"
        parent="booking_engine.booking_engine_rooms_menu"
        sequence="3"
    />

    <menuitem
        id="camping_map_zone_menu"
        name="Camping Map Zones"
        action="camping_map_zone_action"
        parent="camping_maps_menu"
        sequence="10"
    />
</odoo>
