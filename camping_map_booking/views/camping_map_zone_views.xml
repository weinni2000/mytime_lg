<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="camping_map_zone_view_list" model="ir.ui.view">
        <field name="name">camping.map.zone.list</field>
        <field name="model">camping.map.zone</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        name="action_view_map"
                        type="object"
                        string="View on Map"
                        class="btn-primary"
                    />
                </header>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="product_count" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="camping_map_zone_view_form" model="ir.ui.view">
        <field name="name">camping.map.zone.form</field>
        <field name="model">camping.map.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="active" invisible="1" />
                        <field name="points" />
                    </group>
                    <notebook>
                        <page name="pitches" string="Pitches">
                            <field name="product_template_ids">
                                <list>
                                    <field name="name" />
                                    <field name="list_price" />
                                    <field name="website_published" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="camping_map_zone_action" model="ir.actions.act_window">
        <field name="name">Camping Map Zones</field>
        <field name="res_model">camping.map.zone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="camping_map_zone_menu"
        name="Camping Map Zones"
        action="camping_map_zone_action"
        parent="sale.menu_sale_config"
        sequence="60"
    />
</odoo>
