<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_view_form_camping_map_zone" model="ir.ui.view">
        <field name="name">product.template.form.camping.map.zone</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='pricing']/group" position="inside">
                <group name="camping_map" string="Camping Map">
                    <field name="camping_map_zone_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
