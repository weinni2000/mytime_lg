<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="camping_map_state_view_list" model="ir.ui.view">
        <field name="name">camping.map.state.list</field>
        <field name="model">camping.map.state</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="color" widget="color" />
                <field name="stroke_color" />
                <field name="hover_color" />
            </list>
        </field>
    </record>

    <record id="camping_map_state_action" model="ir.actions.act_window">
        <field name="name">Map States</field>
        <field name="res_model">camping.map.state</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="camping_map_state_menu"
        name="Map States"
        action="camping_map_state_action"
        parent="camping_maps_menu"
        sequence="20"
    />
</odoo>
