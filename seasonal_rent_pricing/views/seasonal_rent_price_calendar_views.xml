<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_seasonal_rent_price_calendar_form" model="ir.ui.view">
        <field name="name">seasonal.rent.price.calendar.form</field>
        <field name="model">seasonal.rent.price.calendar</field>
        <field name="arch" type="xml">
            <form string="Mietpreise">
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="pricelist_id" />
                        <field name="month_date" />
                        <field name="currency_id" invisible="1" />
                    </group>
                    <field name="day_ids">
                        <list create="0" delete="0" edit="0">
                            <field name="date" />
                            <field name="weekday_label" />
                            <field name="price" widget="monetary" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seasonal_rent_price_calendar" model="ir.actions.act_window">
        <field name="name">Mietpreise</field>
        <field name="res_model">seasonal.rent.price.calendar</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_seasonal_rent_price_calendar"
        name="Mietpreise"
        parent="sale_renting.rental_menu_root"
        action="action_seasonal_rent_price_calendar"
        sequence="6"
    />

</odoo>
