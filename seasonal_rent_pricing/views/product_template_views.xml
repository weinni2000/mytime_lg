<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_product_template_form_rent_price_calendar" model="ir.ui.view">
        <field name="name">product.template.form.inherit.rent.price.calendar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_renting.product_template_form_view_rental" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pricing']" position="inside">
                <group string="Price Calendar">
                    <field name="rent_calendar_pricelist_id" />
                    <field name="rent_calendar_month" />
                </group>
                <field name="rent_calendar_day_ids" nolabel="1" colspan="2">
                    <list create="0" delete="0" edit="0">
                        <field name="date" />
                        <field name="weekday_label" />
                        <field name="price" widget="monetary" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>

</odoo>
