<odoo noupdate="1">
    <record id="ir_cron_camping_guesty_import" model="ir.cron">
        <field name="name">Camping: Import Guesty Reservations</field>
        <field name="model_id" ref="model_camping_guesty_sync" />
        <field name="state">code</field>
        <field name="code">model._cron_import_guesty_reservations()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="tag_ids" eval="[(4, ref('camping_base.ir_cron_tag_camping'))]" />
    </record>
</odoo>
