    <!-- Whether the guest line has what's required to submit to Feratel (Deskline):
         a name for every guest, plus country/nationality and address for the main guest. -->
    <record id="model_x_guests_line_x_tourist_tax_check" model="ir.model.fields">
        <field name="ttype">selection</field>
        <field
            name="compute"
        ><![CDATA[for record in self:
    if not record.x_guest_partner_id:
        record['x_tourist_tax_check'] = 'na'
        record['x_tourist_tax_warning'] = False
        continue
    missing = []
    if not record.x_guest_name:
        missing.append('Name')
    if record.x_main_guest:
        if not (record.x_calc_nationality_id or record.x_guest_country_id):
            missing.append('Country/Nationality')
        if not record.x_guest_street:
            missing.append('Street')
        if not record.x_guest_zip:
            missing.append('Zip')
        if not record.x_guest_city:
            missing.append('City')
    if missing:
        record['x_tourist_tax_check'] = 'invalid'
        record['x_tourist_tax_warning'] = 'Missing: ' + ', '.join(missing)
    else:
        record['x_tourist_tax_check'] = 'ok'
        record['x_tourist_tax_warning'] = False
]]></field>
        <field
            name="depends"
        >x_main_guest, x_refresh, x_guest_name, x_calc_nationality_id, x_guest_country_id, x_guest_street, x_guest_zip, x_guest_city</field>
        <field name="field_description">Tourist Tax Check</field>
        <field name="model_id" ref="booking_engine.x_model_guests_line" />
        <field name="name">x_tourist_tax_check</field>
        <field name="readonly" eval="True" />
        <field name="selectable" eval="False" />
        <field name="store" eval="False" />
    </record>
