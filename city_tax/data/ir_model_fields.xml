    <!-- Override the Booking Engine identity badge so the company can make
         document checks optional. -->
    <record
        id="booking_engine.x_model_guests_line_x_guest_identity_check"
        model="ir.model.fields"
    >
        <field name="related" eval="False" />
        <field
            name="compute"
        ><![CDATA[for record in self:
    company = record.x_sale_order_id.company_id or record.env.company
    if not company.identity_check_necessary:
        record['x_guest_identity_check'] = 'ok'
    else:
        record['x_guest_identity_check'] = record.x_guest_partner_id.x_identity_check or 'na'
]]></field>
        <field
            name="depends"
        >x_guest_partner_id.x_identity_check, x_sale_order_id.company_id.identity_check_necessary</field>
        <field name="readonly" eval="True" />
        <field name="store" eval="False" />
    </record>

    <record
        id="model_x_guests_line_x_guest_identity_check_selection_na"
        model="ir.model.fields.selection"
    >
        <field name="name">NA</field>
        <field
            name="field_id"
            ref="booking_engine.x_model_guests_line_x_guest_identity_check"
        />
        <field name="value">na</field>
    </record>
    <record
