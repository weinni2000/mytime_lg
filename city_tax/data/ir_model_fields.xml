        <field name="field_id" ref="model_x_guests_line_x_tourist_tax_check" />
        <field name="value">na</field>
    </record>
    <record
        id="model_x_guests_line_x_tourist_tax_check_selection_ok"
        model="ir.model.fields.selection"
    >
        <field name="name">OK</field>
        <field name="field_id" ref="model_x_guests_line_x_tourist_tax_check" />
        <field name="value">ok</field>
    </record>
    <record
        id="model_x_guests_line_x_tourist_tax_check_selection_invalid"
        model="ir.model.fields.selection"
    >
        <field name="name">Invalid</field>
        <field name="field_id" ref="model_x_guests_line_x_tourist_tax_check" />
        <field name="value">invalid</field>
    </record>
    <record id="model_x_guests_line_x_tourist_tax_warning" model="ir.model.fields">
        <field name="ttype">char</field>
        <field
            name="compute"
        ><![CDATA[for record in self:
    if not record.x_guest_partner_id:
        record['x_tourist_tax_check'] = 'na'
        record['x_tourist_tax_warning'] = False
        continue
    missing = []
    if not record.x_guest_name:
        missing.append('Name')
    if record.x_main_guest:
        if not (record.x_calc_nationality_id or record.x_guest_country_id):
            missing.append('Country/Nationality')
        if not record.x_guest_street:
            missing.append('Street')
        if not record.x_guest_zip:
            missing.append('Zip')
        if not record.x_guest_city:
            missing.append('City')
    if missing:
        record['x_tourist_tax_check'] = 'invalid'
        record['x_tourist_tax_warning'] = 'Missing: ' + ', '.join(missing)
    else:
        record['x_tourist_tax_check'] = 'ok'
        record['x_tourist_tax_warning'] = False
]]></field>
        <field
