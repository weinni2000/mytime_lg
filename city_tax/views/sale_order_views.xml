<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rental_order_view_inherit_city_tax" model="ir.ui.view">
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_guest_line_ids']" position="before">
                <button
                    string="Add Customer as Guest"
                    type="object"
                    name="action_add_partner_as_guest"
                    invisible="not partner_id"
                    class="btn-secondary mb-2"
                />
                <button
                    string="Send to Deskline"
                    type="object"
                    name="action_send_to_deskline"
                    invisible="not x_guest_line_ids"
                    confirm="Submit all guests of this order to Deskline?"
                    class="btn-secondary mb-2"
                />
                <button
                    string="Convert to Meldeschein"
                    type="object"
                    name="action_convert_to_meldeschein"
                    invisible="not x_deskline_master_id"
                    confirm="Convert this Deskline registration into a final numbered Meldeschein?"
                    class="btn-secondary mb-2"
                />
                <field
                    name="x_guest_line_ids"
                    string="Order Party"
                    domain="[('x_guest_partner_id', '=', partner_id)]"
                    context="{'default_x_guest_partner_id': partner_id}"
                >
                    <list create="false" delete="false">
                        <field name="x_guest_partner_id" widget="many2one_avatar" />
                        <field
                            name="x_guest_identity_check"
                            widget="badge"
                            decoration-success="x_guest_identity_check == 'ok'"
                            decoration-warning="x_guest_identity_check == 'na'"
                            decoration-danger="x_guest_identity_check == 'invalid'"
                        />
                        <field name="x_room_resource_id" />
                    </list>
                </field>
            </xpath>
            <xpath
                expr="//field[@name='x_guest_line_ids'][not(@domain)]//field[@name='x_guest_partner_id']"
                position="after"
            >
                <field name="x_main_guest" optional="show" />
                <field
                    name="x_main_guest_check"
                    optional="show"
                    widget="badge"
                    readonly="1"
                    decoration-success="x_main_guest_check == 'ok'"
                    decoration-warning="x_main_guest_check == 'na'"
                    decoration-danger="x_main_guest_check == 'invalid'"
                />
            </xpath>
            <xpath
                expr="//field[@name='x_guest_line_ids'][not(@domain)]//field[@name='x_room_resource_id']"
                position="after"
            >
                <field name="x_arrival_date" optional="show" readonly="1" />
                <field name="x_departure_date" optional="show" readonly="1" />
                <field name="x_guest_street" optional="show" readonly="0" />
                <field name="x_guest_zip" optional="show" readonly="0" />
                <field name="x_guest_city" optional="show" readonly="0" />
                <field name="x_guest_country_id" optional="show" readonly="0" />
                <field name="x_calc_nationality_id" optional="show" readonly="0" />
                <field name="x_anrede" optional="show" readonly="0" />
                <field name="x_guest_check_warning" optional="show" />
                <field name="x_refresh" optional="show" widget="boolean_toggle" />
            </xpath>
            <xpath
                expr="//field[@name='x_guest_line_ids'][not(@domain)]/list"
                position="attributes"
            >
                <attribute name="open_form_view">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='x_guest_line_ids'][not(@domain)]"
                position="after"
            >
                <field name="y_guest_line_ids">
                    <list editable="bottom" open_form_view="1">
                        <field name="x_main_guest" />
                        <field
                            name="x_main_guest_check"
                            widget="badge"
                            readonly="1"
                            decoration-success="x_main_guest_check == 'ok'"
                            decoration-warning="x_main_guest_check == 'na'"
                            decoration-danger="x_main_guest_check == 'invalid'"
                        />
                        <field name="x_arrival_date" readonly="1" />
                        <field name="x_departure_date" readonly="1" />
                        <field name="x_guest_partner_id" widget="many2one_avatar" />
                        <field name="x_anrede" optional="show" />
                        <field name="x_guest_nationality" optional="show" />
                        <field name="x_calc_nationality_id" optional="show" />
                        <field name="x_guest_street" optional="show" />
                        <field name="x_guest_zip" optional="show" />
                        <field name="x_guest_city" optional="show" />
                        <field name="x_room_resource_id" />
                        <field name="x_guest_check_warning" optional="show" />
                        <field
                            name="x_refresh"
                            optional="show"
                            widget="boolean_toggle"
                        />
                    </list>
                </field>
            </xpath>
        </field>
        <field name="inherit_id" ref="booking_engine.rental_order_view" />
        <field name="mode">extension</field>
        <field name="model">sale.order</field>
        <field name="name">rental.order.form.inherit.city_tax</field>
        <field name="type">form</field>
        <field name="active" eval="True" />
    </record>
</odoo>
