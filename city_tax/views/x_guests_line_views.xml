<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="x_guests_line_list_view" model="ir.ui.view">
        <field name="name">x_guests_line.list</field>
        <field name="model">x_guests_line</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1" open_form_view="1">
                <field name="x_main_guest" />
                <field
                    name="x_main_guest_check"
                    widget="badge"
                    decoration-success="x_main_guest_check == 'ok'"
                    decoration-warning="x_main_guest_check == 'na'"
                    decoration-danger="x_main_guest_check == 'invalid'"
                />
                <field name="x_guest_check_warning" optional="show" />
                <field name="x_arrival_date" />
                <field name="x_arrival_date_manual" optional="show" />
                <field name="x_planned_departure_date" optional="show" />
                <field name="x_departure_date" />
                <field name="x_departure_date_manual" optional="show" />
                <field name="x_guest_name" />
                <field name="x_anrede" optional="show" />
                <field name="x_guest_title_id" string="Gender" optional="show" />
                <field name="x_guest_lang" optional="show" />
                <field name="x_guest_country_id" optional="show" />
                <field name="x_guest_nationality" optional="show" />
                <field name="x_calc_nationality_id" optional="show" />
                <field name="x_guest_zip" optional="show" />
                <field name="x_guest_city" optional="show" />
                <field name="x_guest_street" optional="show" />
                <field name="x_guest_document_type" optional="show" />
                <field name="x_guest_document_number" optional="show" />
                <field name="x_guest_document_date" optional="show" />
                <field name="x_guest_document_authority" optional="show" />
                <field name="x_guest_birthdate" optional="show" />
                <field name="x_guest_age" optional="show" />
                <field name="x_save_as_contact" optional="show" />
                <field name="x_guest_marketing_consent" optional="show" />
                <field name="x_room_resource_id" />
                <field name="x_sale_order_id" optional="show" />
                <field
                    name="x_guest_identity_check"
                    widget="badge"
                    decoration-success="x_guest_identity_check == 'ok'"
                    decoration-warning="x_guest_identity_check == 'na'"
                    decoration-danger="x_guest_identity_check == 'invalid'"
                />
                <field name="x_name" optional="show" />
            </list>
        </field>
    </record>

    <record id="x_guests_line_form_view" model="ir.ui.view">
        <field name="name">x_guests_line.form</field>
        <field name="model">x_guests_line</field>
        <field name="arch" type="xml">
            <form string="Neumeldung Individualgast">
                <sheet>
                    <group>
                        <field name="x_main_guest" />
                        <field
                            name="x_main_guest_check"
                            widget="badge"
                            readonly="1"
                            decoration-success="x_main_guest_check == 'ok'"
                            decoration-warning="x_main_guest_check == 'na'"
                            decoration-danger="x_main_guest_check == 'invalid'"
                        />
                    </group>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not x_guest_check_warning"
                    >
                        <field name="x_guest_check_warning" nolabel="1" readonly="1" />
                    </div>
                    <group string="Aufenthalt">
                        <field
                            name="x_arrival_date"
                            readonly="bool(x_arrival_date_manual)"
                        />
                        <field name="x_arrival_date_manual" />
                        <field name="x_planned_departure_date" />
                        <field
                            name="x_departure_date"
                            readonly="bool(x_departure_date_manual)"
                        />
                        <field name="x_departure_date_manual" />
                    </group>
                    <group string="Gast">
                        <group>
                            <field name="x_guest_partner_id" widget="many2one_avatar" />
                            <field name="x_guest_name" />
                            <field name="x_anrede" />
                            <field name="x_guest_title_id" />
                            <field name="x_guest_lang" />
                        </group>
                        <group>
                            <field name="x_guest_country_id" />
                            <field name="x_guest_nationality" />
                            <field name="x_guest_zip" />
                            <field name="x_guest_city" />
                            <field name="x_guest_street" />
                        </group>
                    </group>
                    <group string="Reisedokument">
                        <field name="x_guest_document_type" />
                        <field name="x_guest_document_number" />
                        <field name="x_guest_document_date" />
                        <field name="x_guest_document_authority" />
                    </group>
                    <group string="Geburtsdaten">
                        <field name="x_guest_birthdate" />
                        <field name="x_guest_age" readonly="1" />
                    </group>
                    <group>
                        <field name="x_save_as_contact" />
                        <field name="x_guest_marketing_consent" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_guests_line_action" model="ir.actions.act_window">
        <field name="name">Guest Lines</field>
        <field name="res_model">x_guests_line</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_x_guests_line"
        name="Guest Lines"
        parent="menu_city_tax_root"
        action="x_guests_line_action"
        sequence="30"
    />
</odoo>
