<?xml version="1.0" encoding="utf-8" ?>
<odoo auto_sequence="1">
    <record id="account_report_privataufteilung" model="account.report">
        <field name="name">Privataufteilung</field>
        <field name="name@de">Privataufteilung</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss" />
        <field name="filter_date_range" eval="True" />
        <field name="filter_analytic_groupby" eval="True" />
        <field name="hide_analytic_groupby_total" eval="True" />
        <field name="country_id" ref="base.at" />
        <field name="filter_multi_company">selector</field>
        <field
            name="custom_handler_model_id"
            ref="model_account_report_privataufteilung_pl_handler"
        />
        <field name="column_ids">
            <record
                id="account_report_privataufteilung_column"
                model="account.report.column"
            >
                <field name="name">Balance</field>
                <field name="name@de">Saldo</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record
                id="account_report_privataufteilung_line_equity_accounts"
                model="account.report.line"
            >
                <field name="name">Equity / private accounts (e.g. 9400)</field>
                <field name="name@de">Eigenkapital-/Privatkonten (z.B. 9400)</field>
                <field name="code">EQ</field>
                <field
                    name="groupby"
                >account_id, privatkategorie_analytic_account_id</field>
                <field name="foldable" eval="True" />
                <field
                    name="domain_formula"
                >sum([('account_id.account_type', '=', 'equity')])</field>
            </record>
            <record
                id="account_report_privataufteilung_line_other_accounts"
                model="account.report.line"
            >
                <field name="name">Income and expense accounts</field>
                <field name="name@de">Ertrags- und Aufwandskonten</field>
                <field name="code">NEQ</field>
                <field
                    name="groupby"
                >account_id, privatkategorie_analytic_account_id</field>
                <field name="foldable" eval="True" />
                <field
                    name="domain_formula"
                >-sum([('account_id.account_type', 'in', ['income', 'income_other', 'expense', 'expense_other'])])</field>
            </record>
            <record
                id="account_report_privataufteilung_line_total"
                model="account.report.line"
            >
                <field name="name">Total</field>
                <field name="name@de">Gesamt</field>
                <field name="code">TOTAL</field>
                <field name="expression_ids">
                    <record
                        id="account_report_privataufteilung_line_total_balance"
                        model="account.report.expression"
                    >
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">EQ.balance + NEQ.balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
