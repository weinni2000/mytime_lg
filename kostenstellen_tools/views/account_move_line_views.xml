<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_line_tree_kostenstellen_tools" model="ir.ui.view">
        <field name="name">account.move.line.list.kostenstellen.tools</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='move_id'][1]" position="before">
                <button
                    name="action_open_form_view"
                    type="object"
                    icon="fa-external-link"
                    title="Open Journal Item"
                />
            </xpath>
        </field>
    </record>
</odoo>
