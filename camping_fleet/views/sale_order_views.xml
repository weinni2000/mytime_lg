<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_camping_fleet" model="ir.ui.view">
        <field name="name">sale.order.form.camping.fleet</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Vehicles" name="camping_fleet_vehicles">
                    <field name="vehicle_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="license_plate" />
                            <field name="category_id" />
                        </list>
                        <form string="Vehicle">
                            <group>
                                <field name="license_plate" />
                                <field name="category_id" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="fleet_vehicle_model_category_view_form_archivable" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.category.form.archivable</field>
        <field name="model">fleet.vehicle.model.category</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_category_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="active" invisible="1" />
                <widget
                    name="web_ribbon"
                    text="Archived"
                    bg_color="text-bg-danger"
                    invisible="active"
                />
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_model_category_view_list_archivable" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.category.list.archivable</field>
        <field name="model">fleet.vehicle.model.category</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_category_view_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="active" column_invisible="True" />
            </field>
        </field>
    </record>
</odoo>
