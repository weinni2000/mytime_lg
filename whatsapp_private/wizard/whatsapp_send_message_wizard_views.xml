<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_whatsapp_send_message_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.send.message.wizard.form</field>
        <field name="model">whatsapp.send.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field
                        name="company_id"
                        readonly="1"
                        groups="base.group_multi_company"
                    />
                    <field name="partner_id" />
                    <field name="phone" placeholder="+436641234567" />
                    <field name="message" placeholder="Write a message…" />
                </group>
                <footer>
                    <button
                        name="action_send"
                        string="Send"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
