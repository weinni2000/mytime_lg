<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_whatsapp_contact_sync_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.contact.sync.wizard.form</field>
        <field name="model">whatsapp.contact.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Synchronize WhatsApp Contacts">
                <group>
                    <field name="company_id" />
                    <field name="contact_count" />
                    <field name="new_count" />
                    <field name="matched_count" />
                    <field name="ambiguous_count" />
                </group>
                <div
                    class="alert alert-info"
                    role="alert"
                >Existing Odoo names and business data are preserved. Ambiguous phone matches are not selected automatically.</div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" />
                        <field
                            name="status"
                            decoration-warning="status == &apos;ambiguous&apos;"
                        />
                        <field name="proposed_name" />
                        <field name="phone" />
                        <field name="partner_display_name" />
                        <field name="partner_id" optional="hide" />
                        <field name="business_name" optional="hide" />
                        <field name="push_name" optional="hide" />
                        <field name="jid" optional="hide" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import Selected"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
